root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Final newline left unset / optional for Markdown editors
insert_final_newline = unset

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
