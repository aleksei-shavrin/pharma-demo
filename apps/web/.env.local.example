# Native Next only (`npm run web:dev` without Docker Compose).
# Root `.env.local` is for Compose (`npm run dev`) and is a different file.
# Compose injects NEXT_PUBLIC_API_BASE_URL=/backend; do not rely on this file there.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Same-origin docs portal (Compose /docs/; k3s CI /portal/)
# NEXT_PUBLIC_DOCS_BASE_URL=/docs/
