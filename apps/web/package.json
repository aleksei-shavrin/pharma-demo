{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "start:standalone": "node .next-build/standalone/server.js",
    "dev:fresh": "rm -rf .next && next dev --turbopack",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run check:architecture",
    "test:unit": "vitest run",
    "check:architecture": "node scripts/check-no-api-imports.mjs"
  },
  "dependencies": {
    "dhtmlx-gantt": "10.0.3",
    "echarts": "^6.1.0",
    "lucide-react": "^1.66.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vis-data": "^8.0.6",
    "vis-timeline": "^8.5.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
