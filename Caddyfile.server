# Single-origin server demo (ADR-0005). Bind :80 inside container; host maps HOST_PORT.
# Do not use *.localhost — browser talks to HOST:PORT only.

:80 {
	encode gzip

	redir /docs /docs/ 308
	redir /backend /backend/ 308

	# Legacy /portal → /docs (308).
	redir /portal /docs/ 308
	redir /portal/ /docs/ 308
	redir /portal/search /docs/search 308

	@portalDocsLegacy path_regexp portalDocsLegacy ^/portal/docs/(?P<suffix>.+)$
	redir @portalDocsLegacy /docs/{re.portalDocsLegacy.suffix} 308

	@portalOpenspecLegacy path_regexp portalOpenspecLegacy ^/portal/openspec(?P<suffix>/.*)$
	redir @portalOpenspecLegacy /docs/openspec{re.portalOpenspecLegacy.suffix} 308

	@portalAssetsLegacy path_regexp portalAssetsLegacy ^/portal/assets(?P<suffix>/.*)$
	redir @portalAssetsLegacy /docs/assets{re.portalAssetsLegacy.suffix} 308

	# Nest routes stay /health, /v1/..., /api, /api-json after strip.
	handle_path /backend/* {
		reverse_proxy api:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Host {host}
		}
	}

	# Docusaurus built with baseUrl=/docs/; strip so nginx serves from /
	handle_path /docs/* {
		reverse_proxy docs:80
	}

	# Strip client-supplied x-middleware-subrequest (CVE middleware bypass).
	handle {
		reverse_proxy web:3000 {
			header_up -X-Middleware-Subrequest
		}
	}
}
