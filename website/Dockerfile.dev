# Docusaurus development image (live reload). Build context: repository root
FROM node:20-bookworm

WORKDIR /app/website

COPY website/package*.json ./
RUN npm ci

COPY website/docker-dev-entrypoint.sh /usr/local/bin/docker-dev-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-dev-entrypoint.sh

# Runtime mounts: /app/website, /app/docs, /app/openspec/specs
WORKDIR /app/website
EXPOSE 3000
ENTRYPOINT ["docker-dev-entrypoint.sh"]
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "3000"]
