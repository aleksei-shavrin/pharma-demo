# Copy to `.env` for Compose. Do not commit secrets or real tokens.

# OpenSpec CLI: disable telemetry (recommended)
OPENSPEC_TELEMETRY=0

# --- Server Compose (docker-compose.server.yml / npm run server:up) ---
# Public port on the host (keep 8080 locally so npm run dev can keep :80)
HOST_PORT=8080

# Exact origin the browser uses (scheme + host + port, or https://demo.example.com).
# On a remote server set both to the public URL visitors open (CORS + docs build URL).
WEB_ORIGIN=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Baked into Next client bundle at image build (not a runtime override).
# Must stay /backend — Caddyfile.server routes are fixed; other prefixes unsupported.
NEXT_PUBLIC_API_BASE_URL=/backend

# Nest OpenAPI server URL + Swagger UI json fetch (must match Caddy strip).
# Must stay /backend.
PUBLIC_API_PREFIX=/backend

# Optional CSV of extra CORS origins
# CORS_EXTRA_ORIGINS=http://10.0.0.5:8080

# Docusaurus public URL/base (docs image build-args).
# Must stay /docs/ — Caddyfile.server routes are fixed; other prefixes unsupported.
DOCUSAURUS_BASE_URL=/docs/
