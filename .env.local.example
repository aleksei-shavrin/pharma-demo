# Local Docker DX only (copy to repo-root .env.local).
# Apply with: docker compose --env-file .env.local -f docker-compose.dev.yml …
#
# HOST_PORT is substituted into ports:. npm run dev sources this file so it wins
# over a stray HOST_PORT in the parent shell. Still pass --env-file .env.local.
# This file is NOT apps/web/.env.local (native Next without Compose).

HOST_PORT=3080
WEB_ORIGIN=http://localhost:3080
PUBLIC_ORIGIN=http://localhost:3080

# Same-origin path prefixes (ADR-0005 contract; Caddyfile.dev mirrors server paths).
NEXT_PUBLIC_API_BASE_URL=/backend
PUBLIC_API_PREFIX=/backend

DOCUSAURUS_BASE_URL=/docs/
DOCUSAURUS_URL=http://localhost:3080

# WSL / Docker Desktop: enable if live reload misses editor saves.
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
