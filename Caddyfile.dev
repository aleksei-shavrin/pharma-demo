# Local single-origin DX (parity with ADR-0005 path prefixes).
# Host maps HOST_PORT → :80. Browser uses http://localhost:<HOST_PORT>/ only.
# Do not use *.localhost here.

:80 {
	encode gzip

	# Exact /portal → trailing slash (Docusaurus baseUrl=/portal/).
	redir /portal /portal/ 308
	redir /backend /backend/ 308

	# Nest routes stay /health, /v1/..., /api after strip.
	handle_path /backend/* {
		reverse_proxy api:3000
	}

	# Docusaurus dev expects the /portal prefix (no strip — unlike static nginx server).
	handle /portal/* {
		reverse_proxy docs:3000
	}

	# Next.js UI + HMR / Turbopack websockets under /
	handle {
		reverse_proxy web:3000
	}
}
